---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import Toc from '../components/Toc.astro';
import Layout from '../layouts/General.astro';
import { formatDate } from '../utils/util';

interface Props {
  props: CollectionEntry<'blog'>['data'];
  headings: MarkdownHeading[];
  needsMermaid: boolean;
}

const { title, description, pubDate, updatedDate, tags } = Astro.props.props;
let { headings } = Astro.props;
const { needsMermaid } = Astro.props;
// add page title to headings
headings.unshift({ depth: 1, text: title, slug: title });
---

<Layout title={title} description={description} pubDate={pubDate} updatedDate={updatedDate} tags={tags}>
  <div class='main'>
    <Toc headings={headings} />
    <article>
      <div class='prose'>
        <div class='title'>
          <div class='sub'>
            <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
            {
              updatedDate && (
                <span class='last-updated-on'>
                  (↻<time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>更新)
                </span>
              )
            }
            {
              tags.map((tag) => (
                <a href={`/tags/${tag}/`} class='tag'>
                  #{tag}
                </a>
              ))
            }
          </div>
          <h1 id={title}>{title}</h1>
          <hr />
        </div>
        <div class='article'>
          <slot />
        </div>
      </div>
    </article>
  </div>
  <dialog class='figure-zoom' aria-label='図の拡大表示'></dialog>
</Layout>

<style>
  .main {
    display: flex;
    gap: 1em;
    & > article {
      @media (max-width: 768px) {
        width: 100%;
      }

      @media (min-width: 768px) {
        width: calc(100% - 12em);
      }
    }
  }

  /* 拡大表示．dialog を使うと Esc での閉じる・背景の不活性化・フォーカストラップが
     ブラウザ側で面倒を見てくれる */
  .figure-zoom {
    /* 図をぴったり包む．既定だと dialog のほうが大きく，余白が押し出される */
    width: fit-content;
    height: fit-content;
    max-width: 100vw;
    max-height: 100vh;
    padding: 0;
    border: none;
    background: transparent;
    cursor: zoom-out;
    overscroll-behavior: contain;
    /* showModal() が dialog 自体にフォーカスを当てるので枠線が出てしまう．
       閉じる操作は Esc とクリックの両方が効くため外して良い */
    outline: none;

    &::backdrop {
      background: rgb(15 20 35 / 0.97);
    }

    img,
    svg {
      display: block;
      width: auto;
      height: auto;
      max-width: 96vw;
      max-height: 96vh;
      border-radius: var(--radius-md);
    }
  }

  .prose {
    max-width: calc(100% - 2em);
    overflow-x: hidden;
    margin: auto;
    padding: 1em;

    .title {
      margin-bottom: 1em;
      line-height: 1;
      color: var(--text-bright);

      .sub {
        margin-bottom: 0.5em;
        color: rgba(200, 206, 217, 0.7);

        .last-updated-on {
          font-style: italic;
        }

        a {
          margin-left: 0.5em;
          text-decoration: none;
          color: rgba(200, 206, 217, 0.7);

          &:hover {
            color: var(--accent);
          }
        }
      }
    }

    .article {
      h1,
      h2,
      h3,
      h4 {
        margin-top: 2em;
        margin-bottom: 1em;
        background: linear-gradient(transparent 85%, var(--color-gray-700) 85%);
      }

      p {
        padding: 3px 2px;
        margin: 0.5em 0;
      }

      ul,
      ol {
        padding-left: 1.7em;

        li {
          margin: 0.4em 0;
        }
      }
    }

    img {
      display: block;
      height: auto;
      min-width: 80%;
      margin: 2em auto;
    }

    /* 図は本文では列幅に収めて全体を見せ，クリックで画面いっぱいまで拡大する
       (拡大の制御は下のスクリプト) */
    .zoomable {
      cursor: zoom-in;
    }

    .mermaid-container {
      display: flex;
      justify-content: center;
      margin: 1em auto;

      svg {
        p {
          all: unset;
        }
      }
    }
  }

</style>

<script is:inline>
  function attachListenerToCopyButton() {
    async function copyCode(block, button) {
      const code = block.querySelector('code');
      const text = code?.textContent;

      await navigator.clipboard.writeText(text ?? '');

      button.innerText = 'Copied';
      setTimeout(() => {
        button.innerText = 'Copy';
      }, 700);
    }

    const codeBlocks = Array.from(document.querySelectorAll('pre:not(.github-permalink-embed-pre)'));
    for (const codeBlock of codeBlocks) {
      const copyButton = codeBlock.previousElementSibling.querySelector(
        '.remark-code-copy-button',
      );

      copyButton.addEventListener('click', async () => {
        await copyCode(codeBlock, copyButton);
      });
    }
  }
  attachListenerToCopyButton();

  // 図は本文では列幅に収まっているため，狭い画面では文字が小さい．
  // クリックで画面いっぱいまで拡大する．ページ内の dialog なので別タブには飛ばない．
  function setUpFigureZoom() {
    const dialog = document.querySelector('dialog.figure-zoom');
    if (!dialog) return;

    // 拡大表示のどこをクリックしても閉じる (背景・図のどちらでも)
    dialog.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => {
      dialog.replaceChildren();
    });

    function zoom(figure) {
      const clone = figure.cloneNode(true);

      // インライン SVG は width="100%" で描かれるため，複製すると幅が決まらない．
      // viewBox から実寸を読んで，画面に収まる大きさを直接指定する
      const viewBox = figure.viewBox?.baseVal;
      if (viewBox?.width) {
        const scale = Math.min(
          (window.innerWidth * 0.96) / viewBox.width,
          (window.innerHeight * 0.96) / viewBox.height,
        );
        clone.style.width = `${viewBox.width * scale}px`;
        clone.style.height = `${viewBox.height * scale}px`;
        clone.style.maxWidth = 'none';
      }

      dialog.replaceChildren(clone);
      dialog.showModal();
    }

    function registerFigures() {
      const figures = document.querySelectorAll('.prose img, .mermaid-container svg');
      for (const figure of figures) {
        if (figure.classList.contains('zoomable')) continue;

        figure.classList.add('zoomable');
        figure.addEventListener('click', () => zoom(figure));
      }
    }

    registerFigures();
    // mermaid の SVG は描画がクライアント側で後から差し込まれるので，そのたびに登録する
    document.addEventListener('mermaid-rendered', registerFigures);
  }
  setUpFigureZoom();
</script>

{needsMermaid && <script is:inline type='module' src='/js/mermaid.js' />}
